{
  "info": {
    "_postman_id": "d0c3ce07-4c86-4a60-88da-b1411a0d4b87",
    "name": "Hospital Management API - CRUD Tests",
    "description": "End-to-end CRUD requests for doctors, patients, and appointments. Run the collection in order against the running Spring Boot application. Create requests capture IDs for following requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Doctors",
      "item": [
        {
          "name": "Create doctor",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/doctors",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jordan Lee\",\n  \"specialization\": \"Family Medicine\",\n  \"email\": \"jordan.lee@example.com\",\n  \"phone\": \"555-0101\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Doctor created (201)', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Response uses success envelope', function () { pm.expect(body.success).to.eql(true); pm.expect(body.data.id).to.exist;  });",
                  "pm.collectionVariables.set('doctorId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get all doctors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/doctors"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Doctors listed (200)', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Response contains a data array', function () { pm.expect(body.success).to.eql(true); pm.expect(body.data).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get doctor by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/doctors/{{doctorId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Doctor retrieved (200)', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Returned ID matches', function () { pm.expect(body.success).to.eql(true); pm.expect(String(body.data.id)).to.eql(String(pm.collectionVariables.get('doctorId'))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update doctor",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/doctors/{{doctorId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jordan Lee Updated\",\n  \"specialization\": \"Internal Medicine\",\n  \"email\": \"jordan.lee@example.com\",\n  \"phone\": \"555-0101\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Doctor updated (200)', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Updated doctor data returned', function () { pm.expect(body.success).to.eql(true); pm.expect(body.data.name).to.eql('Jordan Lee Updated'); });"
                ]
              }
            }
          ]
        }
      ]
    },

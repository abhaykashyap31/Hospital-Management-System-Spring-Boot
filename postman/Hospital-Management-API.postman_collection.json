            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Appointment created (201)', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Response uses success envelope', function () { pm.expect(body.success).to.eql(true); pm.expect(body.data.id).to.exist; pm.expect(body.data.status).to.eql('SCHEDULED'); });",
                  "pm.collectionVariables.set('appointmentId', body.data.id);"
                ]
              }
            }
          ]
        },

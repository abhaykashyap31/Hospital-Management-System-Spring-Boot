          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Appointment retrieved (200)', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Returned ID matches', function () { pm.expect(body.success).to.eql(true); pm.expect(String(body.data.id)).to.eql(String(pm.collectionVariables.get('appointmentId'))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update appointment",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/appointments/{{appointmentId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": {{doctorId}},\n  \"patientId\": {{patientId}},\n  \"startAt\": \"2027-01-15T10:00:00\",\n  \"endAt\": \"2027-01-15T10:30:00\",\n  \"notes\": \"Consultation completed\",\n  \"status\": \"COMPLETED\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Appointment updated (200)', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Updated appointment data returned', function () { pm.expect(body.success).to.eql(true); pm.expect(body.data.status).to.eql('COMPLETED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete appointment",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/appointments/{{appointmentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Appointment deleted (200)', function () { pm.response.to.have.status(200); });",
                  "pm.test('Delete response uses success envelope', function () { pm.expect(pm.response.json().success).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm deleted appointment returns 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/appointments/{{appointmentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Deleted appointment returns 404', function () { pm.response.to.have.status(404); });",
                  "pm.test('Not-found response uses error envelope', function () { const body = pm.response.json(); pm.expect(body.success).to.eql(false); pm.expect(body.message).to.include('Appointment not found'); });"
                ]
              }
            }
          ]
        }
